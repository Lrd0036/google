{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://runbook.dev/schemas/controlled-cloud-reenable/v0.1.json", "title": "Controlled Cloud Re-enable Release Attestation",
  "type": "object", "additionalProperties": false,
  "required": ["profile", "issued_at", "expires_at", "project_id", "region", "release", "benchmark", "allowed_execution", "gates", "eligible", "signature"],
  "properties": {
    "profile": { "const": "controlled-cloud-reenable/v0.1" }, "issued_at": { "type": "string", "format": "date-time" }, "expires_at": { "type": "string", "format": "date-time" }, "project_id": { "type": "string" }, "region": { "type": "string" },
    "release": { "type": "object", "required": ["image_digests", "terraform_plan_sha256", "state_schema"], "properties": { "image_digests": { "type": "object", "additionalProperties": { "$ref": "#/$defs/sha256" } }, "terraform_plan_sha256": { "$ref": "#/$defs/sha256" }, "state_schema": { "const": "runtime/v1" } } },
    "benchmark": { "type": "object", "required": ["corpus_sha256", "submission_sha256", "report_sha256"], "properties": { "corpus_sha256": { "$ref": "#/$defs/sha256" }, "submission_sha256": { "$ref": "#/$defs/sha256" }, "report_sha256": { "$ref": "#/$defs/sha256" } } },
    "allowed_execution": { "type": "object", "required": ["manifest_sha256", "capabilities", "maximum_risk"], "properties": { "manifest_sha256": { "$ref": "#/$defs/sha256" }, "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "maximum_risk": { "enum": ["R0_OBSERVE", "R1_REVERSIBLE_LOW", "R2_STATEFUL", "R3_HIGH_IMPACT", "R4_IRREVERSIBLE"] } } },
    "gates": { "type": "object", "required": ["corpus_provenance", "annotations", "benchmark", "console", "identity", "authority", "artifacts", "audit", "negative_security", "backup_restore", "alerting"], "additionalProperties": false, "properties": { "corpus_provenance": { "$ref": "#/$defs/gate" }, "annotations": { "$ref": "#/$defs/gate" }, "benchmark": { "$ref": "#/$defs/gate" }, "console": { "$ref": "#/$defs/gate" }, "identity": { "$ref": "#/$defs/gate" }, "authority": { "$ref": "#/$defs/gate" }, "artifacts": { "$ref": "#/$defs/gate" }, "audit": { "$ref": "#/$defs/gate" }, "negative_security": { "$ref": "#/$defs/gate" }, "backup_restore": { "$ref": "#/$defs/gate" }, "alerting": { "$ref": "#/$defs/gate" } } },
    "eligible": { "type": "boolean" }, "signature": { "type": "object", "required": ["algorithm", "key_id", "value"], "properties": { "algorithm": { "const": "RSA-PSS-SHA256" }, "key_id": { "type": "string" }, "value": { "type": "string" } } }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "gate": { "type": "object", "additionalProperties": false, "required": ["status", "evidence_sha256", "observed_at"], "properties": { "status": { "enum": ["PASS", "FAIL"] }, "evidence_sha256": { "$ref": "#/$defs/sha256" }, "observed_at": { "type": "string", "format": "date-time" } } } }
}
