{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runbook.dev/schemas/runbookbench/v0.1.json",
  "title": "RunbookBench Corpus Item",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "corpus_class", "provenance", "annotation_state", "annotation_reviews", "source_text", "annotations"],
  "properties": {
    "schema_version": { "const": "runbookbench/v0.1" },
    "id": { "type": "string", "minLength": 1 },
    "corpus_class": { "enum": ["AUTHENTIC_NORMATIVE", "AUTHENTIC_OPERATIONAL", "STRUCTURED_CONTRACT", "CONSTRUCTED_GOLDEN", "ADVERSARIAL_MUTATION"] },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["publisher", "title", "source_url", "retrieved_at", "retrieved_sha256", "excerpt_sha256", "license_or_use_note", "redistribution", "content_mode"],
      "properties": {
        "publisher": { "type": "string" }, "title": { "type": "string" }, "source_url": { "type": "string" }, "immutable_ref": { "type": "string" },
        "retrieved_at": { "type": "string", "format": "date-time" }, "retrieved_sha256": { "$ref": "#/$defs/sha256" }, "excerpt_sha256": { "$ref": "#/$defs/sha256" },
        "license_or_use_note": { "type": "string" }, "redistribution": { "enum": ["PERMITTED", "RESTRICTED", "CONSTRUCTED"] }, "content_mode": { "enum": ["VERBATIM", "EXCERPT", "PARAPHRASE", "CONSTRUCTED"] },
        "source_locator": { "type": "string" }, "snapshot_path": { "type": "string" }
      }
    },
    "annotation_state": { "enum": ["ANNOTATION_PENDING", "ADJUDICATED"] },
    "annotation_reviews": { "type": "array", "items": { "$ref": "#/$defs/review" } },
    "adjudication": { "$ref": "#/$defs/adjudication" },
    "source_text": { "type": "string", "minLength": 1 },
    "annotations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/annotation" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "review": { "type": "object", "additionalProperties": false, "required": ["reviewer_id", "annotation_sha256", "completed_at"], "properties": { "reviewer_id": { "type": "string" }, "annotation_sha256": { "$ref": "#/$defs/sha256" }, "completed_at": { "type": "string", "format": "date-time" } } },
    "adjudication": { "type": "object", "additionalProperties": false, "required": ["adjudicator_id", "annotation_sha256", "completed_at"], "properties": { "adjudicator_id": { "type": "string" }, "annotation_sha256": { "$ref": "#/$defs/sha256" }, "completed_at": { "type": "string", "format": "date-time" } } },
    "annotation": {
      "type": "object", "additionalProperties": false,
      "required": ["statement_id", "span", "annotated_text", "epistemic", "deontic", "execution_semantics", "consequential"],
      "properties": {
        "statement_id": { "type": "string" }, "span": { "type": "object", "additionalProperties": false, "required": ["start_byte", "end_byte"], "properties": { "start_byte": { "type": "integer", "minimum": 0 }, "end_byte": { "type": "integer", "minimum": 1 } } },
        "annotated_text": { "type": "string" }, "epistemic": { "enum": ["MACHINE_OBSERVATION", "HUMAN_ASSERTION", "DERIVED_FACT", "POLICY_DECLARATION", "HYPOTHESIS"] }, "deontic": { "enum": ["REQUIRED", "PERMITTED", "RECOMMENDED", "PROHIBITED", "OPTIONAL"] }, "execution_semantics": { "enum": ["ACTION", "VERIFY", "HUMAN_APPROVAL", "AGENT_JUDGMENT", "DETERMINISTIC", "TERMINAL"] },
        "consequential": { "type": "boolean" }, "expected_capability": { "type": "string" }, "ambiguous": { "type": "boolean" }, "authority_gate_required": { "type": "boolean" }, "authority_role": { "type": "string" }, "non_delegable": { "type": "boolean" }
      }
    }
  }
}
