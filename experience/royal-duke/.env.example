# Copy to .env.local (or .dev.vars for Wrangler). Git ignores those files.
# This site does not need API keys. Do not put tokens, passwords, or map keys here.

# Optional. Target for the same-origin Vite development proxy.
# ROYAL_DUKE_CONTROLLER_URL=http://127.0.0.1:9400

# Optional. Overrides the OT range controller CORS allowlist
# (range/royal-duke/controller/server.mjs). Keep this tight.
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
