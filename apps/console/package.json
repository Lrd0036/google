{
  "name": "@runbook/console",
  "version": "0.1.0",
  "private": true,
  "description": "Operator Incident Console and Compiler Studio for Runbook Compiler",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
