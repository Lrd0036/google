{
  "manifest_version": "rb-capabilities/v0.1",
  "id": "acme-operations",
  "version": 4,
  "capabilities": [
    {
      "id": "retry_job",
      "version": 1,
      "description": "Retry one ingestion job.",
      "semantic_actions": [
        "retry ingestion job",
        "retry job"
      ],
      "mode": "WRITE",
      "risk": "R1_REVERSIBLE_LOW",
      "transport": {
        "type": "HTTP",
        "service": "acme-worker",
        "method": "POST",
        "path": "/capabilities/retry",
        "audience": "http://acme-worker:8082",
        "allowed_host": "acme-worker:8082"
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id"],
        "properties": {
          "job_id": { "type": "string" }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_id", "status"],
        "properties": {
          "operation_id": { "type": "string" },
          "status": {
            "enum": ["ACCEPTED", "COMPLETED"]
          }
        }
      },
      "timeout_ms": 5000,
      "idempotency": {
        "strategy": "NATIVE_KEY",
        "header": "Idempotency-Key",
        "same_key_replay_safe": true
      },
      "approval_floor": "PREAPPROVED_RUNBOOK",
      "credential_profile": "acme-retry-identity-v1"
    },
    {
      "id": "drain_queue",
      "version": 1,
      "description": "Drain poisoned messages from the ingestion queue into quarantine.",
      "semantic_actions": [
        "drain queue",
        "quarantine corrupted messages"
      ],
      "mode": "WRITE",
      "risk": "R2_STATEFUL",
      "transport": {
        "type": "HTTP",
        "service": "acme-worker",
        "method": "POST",
        "path": "/capabilities/drain",
        "audience": "http://acme-worker:8082",
        "allowed_host": "acme-worker:8082"
      },
      "input_schema": {
        "type": "object",
        "required": ["queue_id"],
        "properties": {
          "queue_id": { "type": "string" }
        }
      },
      "output_schema": {
        "type": "object",
        "required": ["operation_id", "status"],
        "properties": {
          "operation_id": { "type": "string" },
          "status": { "type": "string" }
        }
      },
      "timeout_ms": 10000,
      "idempotency": {
        "strategy": "RECONCILABLE",
        "same_key_replay_safe": false,
        "reconcile_capability": "get_operation_status@1"
      },
      "approval_floor": "OPERATIONS_LEAD",
      "credential_profile": "acme-drain-identity-v1"
    },
    {
      "id": "rotate_auth",
      "version": 1,
      "description": "Rotate the expired partner credential for one ingestion job.",
      "semantic_actions": [
        "rotate auth",
        "rotate partner token"
      ],
      "mode": "WRITE",
      "risk": "R1_REVERSIBLE_LOW",
      "transport": {
        "type": "HTTP",
        "service": "acme-worker",
        "method": "POST",
        "path": "/capabilities/rotate-auth",
        "audience": "http://acme-worker:8082",
        "allowed_host": "acme-worker:8082"
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id"],
        "properties": {
          "job_id": { "type": "string" }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_id", "status"],
        "properties": {
          "operation_id": { "type": "string" },
          "status": {
            "enum": ["ACCEPTED", "COMPLETED"]
          }
        }
      },
      "timeout_ms": 5000,
      "idempotency": {
        "strategy": "NATIVE_KEY",
        "header": "Idempotency-Key",
        "same_key_replay_safe": true
      },
      "approval_floor": "OPERATIONS_LEAD",
      "credential_profile": "acme-rotate-identity-v1"
    },
    {
      "id": "get_job_status",
      "version": 1,
      "description": "Read one ingestion job status.",
      "semantic_actions": ["check job status", "verify job completion"],
      "mode": "READ",
      "risk": "R0_OBSERVE",
      "transport": { "type": "HTTP", "service": "acme-worker", "method": "GET", "path": "/jobs/{job_id}", "audience": "http://acme-worker:8082", "allowed_host": "acme-worker:8082" },
      "input_schema": { "type": "object", "additionalProperties": false, "required": ["job_id"], "properties": { "job_id": { "type": "string" } } },
      "output_schema": { "type": "object", "required": ["job_id", "status"], "properties": { "job_id": { "type": "string" }, "status": { "type": "string" } } },
      "timeout_ms": 3000,
      "idempotency": { "strategy": "NATIVE_KEY", "header": "Idempotency-Key", "same_key_replay_safe": true },
      "approval_floor": "PREAPPROVED_RUNBOOK",
      "credential_profile": "acme-read-identity-v1"
    },
    {
      "id": "get_operation_status",
      "version": 1,
      "description": "Read the status of a previously submitted operation.",
      "semantic_actions": ["reconcile operation", "check operation status"],
      "mode": "READ",
      "risk": "R0_OBSERVE",
      "transport": { "type": "HTTP", "service": "acme-worker", "method": "GET", "path": "/operations/{operation_id}", "audience": "http://acme-worker:8082", "allowed_host": "acme-worker:8082" },
      "input_schema": { "type": "object", "additionalProperties": false, "required": ["operation_id"], "properties": { "operation_id": { "type": "string" } } },
      "output_schema": { "type": "object", "required": ["operation_id", "status"], "properties": { "operation_id": { "type": "string" }, "status": { "type": "string" } } },
      "timeout_ms": 3000,
      "idempotency": { "strategy": "NATIVE_KEY", "header": "Idempotency-Key", "same_key_replay_safe": true },
      "approval_floor": "PREAPPROVED_RUNBOOK",
      "credential_profile": "acme-read-identity-v1"
    }
  ]
}
