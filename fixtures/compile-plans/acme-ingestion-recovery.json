{
  "runbook_id": "acme-ingestion-recovery",
  "version": 7,
  "tenant_id": "acme-demo",
  "entry_node": "classify_failure",
  "context_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["job_id", "failure_mode"],
    "properties": {
      "job_id": { "type": "string", "minLength": 1 },
      "failure_mode": { "type": "string", "enum": ["TRANSIENT_UPSTREAM_FAILURE", "SCHEMA_MISMATCH", "CORRUPTED_BATCH"] }
    }
  },
  "nodes": [
    { "id": "classify_failure", "kind": "DETERMINISTIC", "description": "Route the typed failure mode.", "outcomes": ["TRANSIENT_UPSTREAM_FAILURE", "SCHEMA_MISMATCH", "CORRUPTED_BATCH"] },
    { "id": "retry_job", "kind": "ACTION", "description": "Retry one ingestion job.", "outcomes": ["ACTION_SUCCEEDED", "ACTION_FAILED"], "action": { "capability": "retry_job@1", "parameters": { "job_id": { "ref": "/context/job_id" } } } },
    { "id": "verify_job_completion", "kind": "VERIFY", "description": "Confirm the pipeline resumed.", "outcomes": ["VERIFIED", "FAILED"], "verify": { "target_action_node": "retry_job", "capability": "get_job_status@1", "expected_state": { "job_id": { "ref": "/context/job_id" }, "status": "COMPLETED" } } },
    { "id": "resolved", "kind": "TERMINAL", "description": "Recovery verified.", "outcomes": ["TERMINATED"], "terminal": { "status": "RESOLVED", "reason": "Pipeline resumed and postcondition verified." } },
    { "id": "manual_intervention", "kind": "TERMINAL", "description": "Human intervention required.", "outcomes": ["TERMINATED"], "terminal": { "status": "MANUAL_INTERVENTION_REQUIRED", "reason": "The runbook branch requires an operator." } }
  ],
  "edges": [
    { "id": "edge_transient", "from": "classify_failure", "on": "TRANSIENT_UPSTREAM_FAILURE", "to": "retry_job" },
    { "id": "edge_schema", "from": "classify_failure", "on": "SCHEMA_MISMATCH", "to": "manual_intervention" },
    { "id": "edge_corrupt", "from": "classify_failure", "on": "CORRUPTED_BATCH", "to": "manual_intervention" },
    { "id": "edge_retry_success", "from": "retry_job", "on": "ACTION_SUCCEEDED", "to": "verify_job_completion" },
    { "id": "edge_retry_failure", "from": "retry_job", "on": "ACTION_FAILED", "to": "manual_intervention" },
    { "id": "edge_verified", "from": "verify_job_completion", "on": "VERIFIED", "to": "resolved" },
    { "id": "edge_verify_failed", "from": "verify_job_completion", "on": "FAILED", "to": "manual_intervention" }
  ]
}
