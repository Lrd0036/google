<?xml version="1.0" encoding="UTF-8"?>
<ot-sim>
  <message-bus>
    <pull-endpoint>tcp://127.0.0.1:1234</pull-endpoint>
    <pub-endpoint>tcp://127.0.0.1:5678</pub-endpoint>
  </message-bus>
  <cpu>
    <api-endpoint>0.0.0.0:9101</api-endpoint>
    <module name="backplane">ot-sim-message-bus {{config_file}}</module>
    <module name="logic">ot-sim-logic-module {{config_file}}</module>
    <module name="modbus">ot-sim-modbus-module {{config_file}}</module>
    <module name="dnp3">ot-sim-dnp3-module {{config_file}}</module>
  </cpu>
  <logic name="operator-projection">
    <period>500ms</period>
    <process-updates>true</process-updates>
    <program><![CDATA[
      operator_pressure = view_freeze != 0 ? view_hold_pressure : physical_pressure
      pressure_divergence = abs(operator_pressure - physical_pressure)
      integrity_alarm = pressure_divergence > 2
      view_freeze = view_freeze
      view_hold_pressure = view_hold_pressure
    ]]></program>
    <variables>
      <physical_pressure tag="process.pressure.psi">62</physical_pressure>
      <operator_pressure tag="operator.pressure.psi">62</operator_pressure>
      <view_freeze tag="operator.view.freeze">0</view_freeze>
      <view_hold_pressure tag="operator.view.hold-pressure">62</view_hold_pressure>
      <pressure_divergence tag="integrity.pressure.delta">0</pressure_divergence>
      <integrity_alarm tag="integrity.pressure.alarm">0</integrity_alarm>
    </variables>
  </logic>
  <modbus name="plc-link" mode="client">
    <endpoint>process-plc:502</endpoint>
    <period>500ms</period>
    <register type="coil">
      <address>0</address>
      <tag>process.pump.command</tag>
    </register>
    <register type="coil">
      <address>1</address>
      <tag>safety.interlock.enabled</tag>
    </register>
    <register type="discrete">
      <address>10001</address>
      <tag>process.pump.actual</tag>
    </register>
    <register type="discrete">
      <address>10002</address>
      <tag>alarm.low-pressure</tag>
    </register>
    <register type="input">
      <address>30001</address>
      <tag>process.pressure.psi</tag>
      <scaling>1</scaling>
    </register>
    <register type="input">
      <address>30002</address>
      <tag>process.flow.gpm</tag>
    </register>
    <register type="input">
      <address>30003</address>
      <tag>process.reservoir.percent</tag>
      <scaling>1</scaling>
    </register>
    <register type="holding">
      <address>40001</address>
      <tag>process.pressure.setpoint</tag>
      <scaling>1</scaling>
    </register>
  </modbus>
  <dnp3 name="operator-dnp3" mode="server">
    <endpoint>0.0.0.0:20000</endpoint>
    <outstation name="royal-duke-water">
      <local-address>1024</local-address>
      <remote-address>1</remote-address>
      <input type="binary">
        <address>0</address>
        <tag>process.pump.actual</tag>
        <class>Class1</class>
      </input>
      <input type="binary">
        <address>1</address>
        <tag>alarm.low-pressure</tag>
        <class>Class1</class>
      </input>
      <input type="binary">
        <address>2</address>
        <tag>integrity.pressure.alarm</tag>
        <class>Class1</class>
      </input>
      <output type="binary">
        <address>10</address>
        <tag>process.pump.command</tag>
        <class>Class1</class>
        <sbo>true</sbo>
      </output>
      <input type="analog">
        <address>0</address>
        <tag>operator.pressure.psi</tag>
        <class>Class1</class>
      </input>
      <input type="analog">
        <address>1</address>
        <tag>process.pressure.psi</tag>
        <class>Class1</class>
      </input>
      <input type="analog">
        <address>2</address>
        <tag>process.flow.gpm</tag>
        <class>Class1</class>
      </input>
    </outstation>
  </dnp3>
</ot-sim>
